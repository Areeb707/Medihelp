# ------------------------------------------------------------------------------
# MediMem AI Backend - Environment Configuration Template
# ------------------------------------------------------------------------------
# Usage: Copy this file to '.env' and fill in the required values.
# IMPORTANT: Never commit your actual .env file to version control.
# ------------------------------------------------------------------------------

# ── Cognee Cloud Configuration ────────────────────────────────────────────────
# API Key for authenticating with your Cognee Cloud instance
COGNEE_API_KEY=your_cognee_api_key_here

# Base URL for the Cognee Cloud tenant (e.g., https://tenant-id.aws.cognee.ai)
COGNEE_BASE_URL=https://your-tenant-id.aws.cognee.ai

# ── LLM Configuration ─────────────────────────────────────────────────────────
# API Key for the chosen LLM provider
LLM_API_KEY=your_llm_api_key_here

# Provider type (e.g., groq, openai, anthropic)
LLM_PROVIDER=groq

# Model name to use for chat and clinical briefs
LLM_MODEL=llama-3.1-8b-instant
